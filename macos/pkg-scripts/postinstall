#!/bin/bash
# Copy the daemon, the translation plugin and the model CLI to the console
# user, then start the agent. A missing binary makes the wrapper exit 0, so launchd does not
# restart in a loop.
set -euo pipefail
user=$(stat -f '%Su' /dev/console)
if [[ -z "$user" || "$user" == "root" ]]; then
    exit 0
fi
home=$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')
uid=$(id -u "$user")
support="$home/Library/Application Support/ChewingPlus"
payload="/Library/Application Support/ChewingPlus"
mkdir -p "$support/models" "$home/Library/LaunchAgents"
# postinstall runs as root; the user's daemon writes model files here.
chown "$user" "$support" "$support/models" "$home/Library/LaunchAgents"
if [[ -f "$payload/voxkit" ]]; then
    cp "$payload/voxkit" "$support/voxkit"
    chown "$user" "$support/voxkit"
    chmod 755 "$support/voxkit"
fi
# The translation plugin goes next to the daemon, where voxkit looks first.
if [[ -f "$payload/libvoxkit-mt.dylib" ]]; then
    cp "$payload/libvoxkit-mt.dylib" "$support/libvoxkit-mt.dylib"
    chown "$user" "$support/libvoxkit-mt.dylib"
    chmod 644 "$support/libvoxkit-mt.dylib"
fi
if [[ -f "$payload/chewing-plus-models" ]]; then
    cp "$payload/chewing-plus-models" "$support/chewing-plus-models"
    chown "$user" "$support/chewing-plus-models"
    chmod 755 "$support/chewing-plus-models"
fi
cat > "$support/voxkit-launch.sh" <<'EOF'
#!/bin/sh
set -eu
home=${HOME:?}
bin="$home/Library/Application Support/ChewingPlus/voxkit"
if [ ! -x "$bin" ]; then
    echo "voxkit: binary missing; not restarting" >&2
    exit 0
fi
# launchd gives a bare PATH (/usr/bin:/bin:...). voxkit finds OpenCC for the
# Simplified -> Traditional (s2twp) step through PATH and OPENCC_DATA_DIR; without
# Homebrew here every transcript stays Simplified (Qwen3-ASR emits Simplified).
for prefix in /opt/homebrew /usr/local; do
    if [ -x "$prefix/bin/opencc" ]; then
        PATH="$prefix/bin:$PATH"
        if [ -z "${OPENCC_DATA_DIR:-}" ] && [ -f "$prefix/share/opencc/s2twp.json" ]; then
            OPENCC_DATA_DIR="$prefix/share/opencc"
        fi
    fi
done
export PATH
if [ -n "${OPENCC_DATA_DIR:-}" ]; then
    export OPENCC_DATA_DIR
fi
exec "$bin" serve
EOF
chmod 755 "$support/voxkit-launch.sh"
agent="$home/Library/LaunchAgents/im.chewing.plus.voxkit.plist"
# Keep the user's choice across upgrades: an agent that was enabled stays
# enabled. A new install starts disabled; the installer's optional
# 「啟用語音」 choice (pkg-voice-scripts) or the input menu turns it on.
was_enabled=false
if [[ -f "$agent" ]] &&
    [[ "$(/usr/libexec/PlistBuddy -c 'Print :Disabled' "$agent" 2>/dev/null || echo false)" == false ]]; then
    was_enabled=true
fi
sed "s|__HOME__|$home|g" "$(dirname "$0")/agent.plist" > "$agent"
/usr/libexec/PlistBuddy -c "Add :Disabled bool true" "$agent" 2>/dev/null || true
if [[ "$was_enabled" == true ]]; then
    /usr/libexec/PlistBuddy -c "Set :Disabled false" "$agent"
fi
chown "$user" "$support/voxkit-launch.sh" \
    "$home/Library/LaunchAgents/im.chewing.plus.voxkit.plist"
launchctl bootout "gui/$uid/im.chewing.plus.voxkit" 2>/dev/null || true
if [[ "$was_enabled" == true ]]; then
    launchctl bootstrap "gui/$uid" "$agent" || true
fi
# Register and enable the input source in the user's session, so it is in
# the input menu without logging out. A stale copy is stopped first.
app="/Library/Input Methods/ChewingPlus.app"
pkill -u "$uid" -x ChewingPlus 2>/dev/null || true
# A per-user copy from macos/install.sh would shadow this one (same bundle
# id), so Text Input Sources may pick either. The pkg owns the system copy.
user_app="$home/Library/Input Methods/ChewingPlus.app"
if [[ -d "$user_app" ]]; then
    lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
    "$lsregister" -u "$user_app" 2>/dev/null || true
    rm -rf "$user_app"
fi
launchctl asuser "$uid" sudo -u "$user" \
    "$app/Contents/MacOS/ChewingPlus" --register || true
exit 0
