#!/bin/bash
# The installer's optional "啟用語音" choice: start the voxkit agent for the
# console user. Without this choice the agent is installed but not loaded;
# the user can turn voice on later from the input menu.
set -euo pipefail
user=$(stat -f '%Su' /dev/console)
if [[ -z "$user" || "$user" == "root" ]]; then
    exit 0
fi
home=$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')
uid=$(id -u "$user")
agent="$home/Library/LaunchAgents/im.chewing.plus.voxkit.plist"
[[ -f "$agent" ]] || exit 0
# The main component writes the agent with Disabled=true; flip it.
/usr/libexec/PlistBuddy -c "Set :Disabled false" "$agent" 2>/dev/null ||
    /usr/libexec/PlistBuddy -c "Add :Disabled bool false" "$agent"
chown "$user" "$agent"
launchctl bootout "gui/$uid/im.chewing.plus.voxkit" 2>/dev/null || true
launchctl bootstrap "gui/$uid" "$agent" || true
exit 0
