# One installable package per input framework, like the macOS pkg: each
# carries libchewing 0.14, the input method, the voxkit dictation daemon and
# the Plus data. Driven by packaging/release/build-arch.sh (CI).
#
#   chewing-plus-fcitx5   fcitx5 addon + fcitx5-voxkit module + voxkit daemon
#                         + the 語音模型 window (menu entry, config button,
#                         launcher)
#   chewing-plus-ibus     IBus engine + setup window + voxkit daemon
#                         + the 語音模型 window
#   chewing-plus-translate  optional: voxkit's llama.cpp translation plugin
#                           (/usr/lib/voxkit/libvoxkit-mt.so) for either one
#
# They replace the separate packages of 5.1.13-plus.1..4 (libchewing-plus,
# fcitx5-chewing-plus, ibus-chewing-plus, fcitx5-voxkit). Both bundle the
# same libchewing and voxkit files, so they conflict with each other.
pkgbase=chewing-plus
pkgname=(chewing-plus-fcitx5 chewing-plus-ibus chewing-plus-translate)
pkgver=${CHEWING_PLUS_PKGVER:-6.1.2}
pkgrel=1
arch=(x86_64)
url="https://github.com/siygle/chewing-plus"
license=(LGPL-2.1-or-later MIT)
makedepends=(cmake extra-cmake-modules ninja rust git fcitx5 ibus libadwaita
             json-c alsa-lib opencc)
options=(!debug !lto)
_src=${CHEWING_PLUS_SRC:?set by build-arch.sh}
_lc=${CHEWING_PLUS_LIBCHEWING_SRC:?set by build-arch.sh}
_vk=${CHEWING_PLUS_VOXKIT_SRC:?set by build-arch.sh}
# llama.cpp at the commit in $_vk/daemon/mt-plugin/LLAMA_PIN.
_llama=${CHEWING_PLUS_LLAMA_SRC:?set by build-arch.sh}

build() {
  # libchewing 0.14 (pinned). Its CMake runs `git describe` in the source dir.
  (cd "$_lc" && cmake -S "$_lc" -B "$srcdir/build-libchewing" -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON -DBUILD_DOC=OFF -DBUILD_TESTING=OFF)
  cmake --build "$srcdir/build-libchewing"
  # Stage it so the input methods build against 0.14, not a system 0.13.
  DESTDIR="$srcdir/libchewing-stage" cmake --install "$srcdir/build-libchewing"
  local stage="$srcdir/libchewing-stage/usr"
  # chewing.pc says prefix=/usr. Rewrite only that file to point at the
  # stage (a global PKG_CONFIG_SYSROOT_DIR would also move json-c, fcitx5...).
  mkdir -p "$srcdir/pc"
  # libdir and includedir are written out in full, so rewrite every /usr.
  sed "s|=/usr|=$stage|g" "$stage/lib/pkgconfig/chewing.pc" \
    > "$srcdir/pc/chewing.pc"
  export PKG_CONFIG_PATH="$srcdir/pc"

  # voxkit: fcitx5 module (CMake) and the dictation daemon (cargo).
  cmake -S "$_vk" -B "$srcdir/build-voxkit" -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release -DENABLE_TEST=OFF
  cmake --build "$srcdir/build-voxkit"
  DESTDIR="$srcdir/voxkit-stage" cmake --install "$srcdir/build-voxkit"
  # Portable CPU floor (x86-64-v3) instead of tuning ggml to the CI host.
  TRANSCRIBE_CMAKE_ARGS="-DGGML_NATIVE=OFF -DGGML_SSE42=ON -DGGML_AVX=ON -DGGML_F16C=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_BMI2=ON -DGGML_AVX512=OFF" \
    cargo build --release --locked --manifest-path "$_vk/daemon/Cargo.toml" \
      --target-dir "$srcdir/cargo-target"
  # Translation plugin: llama.cpp with its own static ggml, loaded by the
  # daemon with dlopen only when someone translates. Same CPU floor.
  cmake -S "$_vk/daemon/mt-plugin" -B "$srcdir/build-mt" -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
    -DLLAMA_CPP_SOURCE_DIR="$_llama" \
    -DGGML_NATIVE=OFF -DGGML_SSE42=ON -DGGML_AVX=ON -DGGML_F16C=ON -DGGML_AVX2=ON \
    -DGGML_FMA=ON -DGGML_BMI2=ON -DGGML_AVX512=OFF
  cmake --build "$srcdir/build-mt"

  # fcitx5 addon, built against the staged voxkit module. Its CMake config
  # names /usr/include outright, so the staged header dir is added too.
  local vkinc="$srcdir/voxkit-stage/usr/include/Fcitx5/Module/fcitx-module/voxkit"
  CXXFLAGS="${CXXFLAGS} -I$vkinc" \
  cmake -S "$_src" -B "$srcdir/build-fcitx5" -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release -DENABLE_TEST=OFF -DENABLE_VOXKIT=ON \
    -DENABLE_MODEL_MANAGER=ON \
    -DCMAKE_PREFIX_PATH="$stage;$srcdir/voxkit-stage/usr"
  cmake --build "$srcdir/build-fcitx5"
  # IBus engine and setup window (no fcitx5).
  cmake -S "$_src" -B "$srcdir/build-ibus" -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release -DENABLE_TEST=OFF -DCHEWING_PLUS_CORE_ONLY=ON \
    -DENABLE_IBUS=ON -DENABLE_IBUS_SETUP=ON -DENABLE_MODEL_MANAGER=ON
  cmake --build "$srcdir/build-ibus"
}

# Parts shared by both bundles.
_install_common() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-libchewing"
  install -Dm755 "$srcdir/cargo-target/release/voxkit" "$pkgdir/usr/bin/voxkit"
  # The user unit is installed but not enabled: the daemon keeps the speech
  # model in memory (~260 MB) once one is downloaded. Users turn it on from
  # the settings ("啟用語音") or with: systemctl --user enable --now voxkit
  install -Dm644 "$_vk/daemon/systemd/voxkit.service" \
    "$pkgdir/usr/lib/systemd/user/voxkit.service"
  install -Dm644 "$_vk/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/voxkit-LICENSE"
  install -Dm644 "$_vk/daemon/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/voxkit-NOTICE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "$_src/data/LICENSE.gemoji" "$_src/data/LICENSE.scowl"
}

# Headers, static archives and CMake package files are build-time only.
_strip_dev() {
  rm -rf "$pkgdir/usr/include" "$pkgdir/usr/lib/cmake" "$pkgdir/usr/lib/pkgconfig"
  rm -f "$pkgdir"/usr/lib/*.a
}

_old_packages=(libchewing-plus fcitx5-chewing-plus ibus-chewing-plus fcitx5-voxkit)

package_chewing-plus-fcitx5() {
  pkgdesc="新酷音 Plus for Fcitx5 (all-in-one: libchewing 0.14, Plus features, voxkit dictation)"
  # opencc: dictation output in Traditional Chinese (s2twp). Without it the
  # transcript stays Simplified.
  # libadwaita: the 語音模型 window (chewing-plus-model-manager, GTK4).
  depends=(fcitx5 json-c alsa-lib opencc libadwaita gcc-libs glibc)
  provides=("libchewing=0.14.0" libchewing.so "fcitx5-chewing=${pkgver}"
            "fcitx5-voxkit=${pkgver}")
  conflicts=(libchewing fcitx5-chewing chewing-plus-ibus "${_old_packages[@]}")
  # Official packages and the old split Plus packages. `replaces=` is
  # honoured on `pacman -Syu`; a local `pacman -U` still prompts, and
  # `--noconfirm` answers N — use packaging/release/install-arch.sh.
  replaces=(libchewing fcitx5-chewing libchewing-plus fcitx5-chewing-plus fcitx5-voxkit)
  install=chewing-plus.install
  _install_common
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-voxkit"
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-fcitx5"
  _strip_dev
}

package_chewing-plus-ibus() {
  pkgdesc="新酷音 Plus for IBus (all-in-one: libchewing 0.14, Plus features, voxkit dictation)"
  depends=(ibus libadwaita alsa-lib opencc gcc-libs glibc)
  provides=("libchewing=0.14.0" libchewing.so)
  conflicts=(libchewing chewing-plus-fcitx5 "${_old_packages[@]}")
  replaces=(libchewing libchewing-plus ibus-chewing-plus)
  install=chewing-plus.install
  _install_common
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-ibus"
  _strip_dev
}

package_chewing-plus-translate() {
  pkgdesc="新酷音 Plus voice translation plugin for voxkit (llama.cpp; HY-MT1.5 model downloaded on first use)"
  depends=(gcc-libs glibc)
  optdepends=('chewing-plus-fcitx5: voxkit daemon and the Right Ctrl translate key'
              'chewing-plus-ibus: voxkit daemon and the Right Ctrl translate key')
  license=(MIT)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-mt"
  install -Dm644 "$_llama/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/llama.cpp-LICENSE"
  install -Dm644 "$_vk/daemon/mt-plugin/LLAMA_PIN" "$pkgdir/usr/share/licenses/$pkgname/LLAMA_PIN"
}
