# Release build of the pinned libchewing 0.14 for fcitx5-chewing-plus.
# Driven by packaging/release/build-arch.sh (CI); not for local ~/Work use.
pkgname=libchewing-plus
pkgver=${CHEWING_PLUS_LC_PKGVER:-0.14.0rc1}
pkgrel=1
pkgdesc="Intelligent Chinese phonetic input method library (0.14, for fcitx5-chewing-plus)"
arch=(x86_64)
url="https://codeberg.org/chewing/libchewing"
license=(LGPL-2.1-or-later)
depends=(glibc gcc-libs)
makedepends=(cmake ninja rust git)
provides=("libchewing=${pkgver}" libchewing.so)
conflicts=(libchewing)
options=(!debug !lto)
_src=${CHEWING_PLUS_LIBCHEWING_SRC:?set by build-arch.sh}
build() {
  # libchewing's CMake runs `git describe` in the current directory.
  cd "$_src"
  cmake -S "$_src" -B "$srcdir/build" -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DBUILD_DOC=OFF -DBUILD_TESTING=OFF
  cmake --build "$srcdir/build"
}
package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
